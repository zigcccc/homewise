{
  "name": "homewise",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter @homewise/web-app --cwd ./apps/web",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome check --write .",
    "knip": "knip",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @homewise/e2e test",
    "db:migrations:create": "turbo run db:migrations:create",
    "db:migrations:apply": "turbo run db:migrations:apply",
    "db:studio": "turbo run db:studio",
    "prepare": "husky"
  },
  "dependencies": {
    "hono": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@homewise/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "turbo": "^2.10.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=24"
  }
}
