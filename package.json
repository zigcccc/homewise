{
  "name": "homewise",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:backend": "turbo run build --filter @homewise/server --cwd ./apps/server",
    "build:web": "turbo run build --filter @homewise/web-app --cwd ./apps/web",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome check --write .",
    "knip": "knip",
    "check-types": "turbo run check-types",
    "test:e2e": "pnpm --filter @homewise/e2e test",
    "db:migrations:create": "turbo run db:migrations:create",
    "db:migrations:apply": "turbo run db:migrations:apply",
    "db:studio": "turbo run db:studio",
    "prepare": "husky"
  },
  "dependencies": {
    "hono": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@homewise/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=24"
  }
}
