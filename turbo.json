{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "db:up": {
      "dependsOn": ["^db:up"],
      "cache": false
    },
    "db:migrations:create": {
      "cache": false
    },
    "db:migrations:apply": {
      "cache": false
    },
    "db:studio": {
      "dependsOn": ["db:up"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      // Read by the Vite build only. `envMode` is strict, so anything not named here is invisible to
      // the build; platform vars like `VERCEL` arrive through turbo's own allowlist instead.
      "env": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VITE_API_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "VITE_SENTRY_RELEASE"
      ],
      // The server function's runtime variables. Neither build reads them, so they stay out of `env`
      // and out of the cache key — otherwise rotating a secret would rebuild both apps.
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "HOMEWISE_ABLY_API_KEY",
        "HOMEWISE_FILES_READ_WRITE_TOKEN",
        "HOMEWISE_REALTIME_NAMESPACE",
        "HOMEWISE_RESEND_API_KEY",
        "NODEJS_HELPERS",
        "PREVIEW_WEB_ORIGIN",
        "SENTRY_DSN"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".vercel/**"]
    },
    "check-types": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/typescript-config/*.json", "!**/*.md"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["db:up"],
      "with": ["db:studio"],
      "cache": false,
      "persistent": true
    }
  }
}
