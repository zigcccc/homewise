{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "db:up": {
      "dependsOn": ["^db:up"],
      "cache": false
    },
    "db:migrations:create": {
      "cache": false
    },
    "db:migrations:apply": {
      "cache": false
    },
    "db:studio": {
      "dependsOn": ["db:up"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      // `apps/web` is the only package that builds — the server ships its source and Vercel compiles
      // it, and its preview migrate/seed runs outside turbo. So this list is exactly what a Vite
      // build reads: the `VITE_*` four the bundle inlines, plus the three the Sentry plugin needs.
      // `envMode` is strict, so anything dropped from here is invisible to the build — but platform
      // vars like `VERCEL` arrive through turbo's own allowlist and must not be added (verified).
      "env": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VITE_API_URL",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "VITE_SENTRY_RELEASE"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".vercel/**"]
    },
    "check-types": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/typescript-config/*.json", "!**/*.md"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["db:up"],
      "with": ["db:studio"],
      "cache": false,
      "persistent": true
    }
  }
}
