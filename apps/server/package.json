{
  "name": "@homewise/server",
  "type": "module",
  "types": "./src/index.ts",
  "imports": {
    "#config/*": "./src/config/*.ts",
    "#db/*": "./src/db/*.ts",
    "#emails/*": "./src/emails/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#middleware/*": "./src/middleware/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#types/*": "./src/types/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./seed-fixtures": {
      "types": "./src/db/seed-fixtures.ts",
      "import": "./src/db/seed-fixtures.ts"
    },
    "./models": {
      "types": "./src/lib/models.ts",
      "import": "./src/lib/models.ts"
    },
    "./households": {
      "types": "./src/modules/households/households.model.ts",
      "import": "./src/modules/households/households.model.ts"
    },
    "./child-dictionaries": {
      "types": "./src/modules/child-dictionaries/child-dictionaries.model.ts",
      "import": "./src/modules/child-dictionaries/child-dictionaries.model.ts"
    },
    "./child-profiles": {
      "types": "./src/modules/child-profiles/child-profiles.model.ts",
      "import": "./src/modules/child-profiles/child-profiles.model.ts"
    },
    "./pet-profiles": {
      "types": "./src/modules/pet-profiles/pet-profiles.model.ts",
      "import": "./src/modules/pet-profiles/pet-profiles.model.ts"
    },
    "./contacts": {
      "types": "./src/modules/contacts/contacts.model.ts",
      "import": "./src/modules/contacts/contacts.model.ts"
    },
    "./medical": {
      "types": "./src/modules/medical/medical.model.ts",
      "import": "./src/modules/medical/medical.model.ts"
    },
    "./recipes": {
      "types": "./src/modules/recipes/recipes.model.ts",
      "import": "./src/modules/recipes/recipes.model.ts"
    },
    "./ingredients": {
      "types": "./src/modules/ingredients/ingredients.model.ts",
      "import": "./src/modules/ingredients/ingredients.model.ts"
    },
    "./stores": {
      "types": "./src/modules/stores/stores.model.ts",
      "import": "./src/modules/stores/stores.model.ts"
    },
    "./shopping-lists": {
      "types": "./src/modules/shopping-lists/shopping-lists.model.ts",
      "import": "./src/modules/shopping-lists/shopping-lists.model.ts"
    },
    "./meal-plan": {
      "types": "./src/modules/meal-plan/meal-plan.model.ts",
      "import": "./src/modules/meal-plan/meal-plan.model.ts"
    },
    "./expenses": {
      "types": "./src/modules/expenses/expenses.model.ts",
      "import": "./src/modules/expenses/expenses.model.ts"
    },
    "./expense-categories": {
      "types": "./src/modules/expense-categories/expense-categories.model.ts",
      "import": "./src/modules/expense-categories/expense-categories.model.ts"
    },
    "./realtime": {
      "types": "./src/modules/realtime/realtime.model.ts",
      "import": "./src/modules/realtime/realtime.model.ts"
    }
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:studio": "drizzle-kit studio",
    "db:migrations:create": "drizzle-kit generate",
    "db:migrations:apply": "drizzle-kit migrate",
    "dev": "tsx watch ./src/index.ts",
    "build": "esbuild ./src/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --jsx=automatic --outfile=./dist/index.js",
    "build:vercel": "bash ./scripts/vercel-build.sh",
    "db:seed": "tsx ./src/db/seed.ts",
    "check-types": "tsc --noEmit",
    "emails:preview": "email dev --port 4000"
  },
  "dependencies": {
    "@date-fns/utc": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "@sentry/hono": "catalog:",
    "@sentry/node": "catalog:",
    "@vercel/blob": "catalog:",
    "@vercel/functions": "catalog:",
    "ably": "catalog:",
    "better-auth": "catalog:",
    "date-fns": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@homewise/typescript-config": "workspace:*",
    "@react-email/ui": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "catalog:",
    "pg": "catalog:",
    "react-email": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
